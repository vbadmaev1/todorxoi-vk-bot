# Скопируйте этот файл в .env и заполните.
# .env в git не попадает (см. .gitignore) — ключ там и должен оставаться.

# Ключ доступа сообщества — единственная обязательная переменная.
# Сообщество → Управление → Работа с API → Ключи доступа → Создать ключ.
# Права: «управление сообществом» (ОБЯЗАТЕЛЬНО — без него VK не даёт
# Long Poll, бот не получит ни одного сообщения), «сообщения сообщества»,
# «фотографии», «документы». Права у готового ключа не меняются — если
# забыли отметить, создайте новый.
VK_TOKEN=vk1.a.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# id сообщества (число, без минуса). Можно не задавать — бот узнает его по ключу.
# VK_GROUP_ID=

# На старте включить в сообществе Long Poll (API 5.199, события
# «Входящее сообщение» и «Действие с сообщением»), сообщения и
# возможности ботов. Нужен ключ с правом «управление сообществом».
VK_SETUP_LONGPOLL=true

# id ВКонтакте тех, кому доступны /stats и /export.
# Свой id — в адресе страницы (vk.com/id12345) или в настройках профиля.
# Несколько — через запятую. Пока пусто — админских команд нет ни у кого.
ADMIN_IDS=

# Куда складывать базу и лог фидбэка.
# ВАЖНО: на хостинге с эфемерным диском это должен быть volume,
# иначе весь собранный фидбэк исчезнет при рестарте.
DATA_DIR=./data

# Пути к артефактам (по умолчанию — те, что лежат в репозитории)
# MODEL_PATH=./model/translit_model.npz
# FONT_PATH=./assets/MongolianUniversalWhite.ttf

# Распознавание фото (/ocr)
# OCR_MODEL_PATH=./model/todo_ocr_int8.onnx
# Потоков на одну картинку; по умолчанию — число ядер, но не больше 4
# OCR_THREADS=
# Присылать вместе с текстом картинку с рамками столбцов (~50 мс и один JPEG)
OCR_OVERLAY=true

# Прогревать модель на старте (первый пользователь не ждёт загрузку)
WARMUP=true

# Показывать 👍/👎 ещё и под обычной транслитерацией, а не только
# под тодо бичиг и картинкой
FEEDBACK_ON_TRANSLIT=true

# Ссылка на новости под «Начать» и «Помощь»; пусто — без ссылки
NEWS_URL=https://t.me/todorxoi_uzuq

# Сколько сообщений обрабатывать одновременно (распознавание фото всё
# равно идёт по одному — ради памяти)
WORKERS=8

# Если в окружении нет ни uharfbuzz, ни Pillow с Raqm, буквы не соединяются.
# По умолчанию бот всё равно рисует картинку, но помечает её
# предупреждением. STRICT_SHAPING=1 — вместо этого отказывать в рендере.
STRICT_SHAPING=0

LOG_LEVEL=INFO
